{
  "info": {
    "name": "Campus Store API",
    "description": "Smoke test for every minimum case in dev_docs/05-api-reference.md Section 10 (CS-26).\n\nRun the whole collection in order (Run collection, or `npx newman run backend/campus-store.postman_collection.json`). It creates its own product and sells only that product, so it can be run again and again on any data. Set baseUrl to the API (default http://localhost:8000/api).\n\nNot covered yet: GET /api/summary (added with CS-60).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "productName",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "spareId",
      "value": ""
    },
    {
      "key": "saleId",
      "value": ""
    },
    {
      "key": "stockBefore",
      "value": ""
    },
    {
      "key": "upperName",
      "value": ""
    },
    {
      "key": "forgedSaleId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health and errors",
      "item": [
        {
          "name": "GET /health -> 200 ok",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('database ok', () => pm.expect(pm.response.json()).to.eql({ status: 'ok', database: 'ok' }));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /nope -> 404 ROUTE_NOT_FOUND",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/nope"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code ROUTE_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('ROUTE_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Broken JSON -> 400 INVALID_JSON",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Oops\", "
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code INVALID_JSON', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_JSON'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "POST /products valid -> 201",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{productName}}\",\n  \"category_id\": 1,\n  \"price\": 20,\n  \"stock_quantity\": 40,\n  \"reorder_level\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A unique name on every run, because product names must be unique.",
                  "pm.collectionVariables.set('productName', 'Smoke Test ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Location header', () => pm.response.to.have.header('Location', '/api/products/' + pm.response.json().data.id));",
                  "pm.collectionVariables.set('productId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /products same name, other case -> 409 DUPLICATE",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{upperName}}\",\n  \"category_id\": 1,\n  \"price\": 20,\n  \"stock_quantity\": 40,\n  \"reorder_level\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('upperName', pm.collectionVariables.get('productName').toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code DUPLICATE', () => pm.expect(pm.response.json().error.code).to.eql('DUPLICATE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /products price -1 -> 400 on price",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Negative Price Item\",\n  \"category_id\": 1,\n  \"price\": -1,\n  \"stock_quantity\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('details[0].field is price', () => pm.expect(pm.response.json().error.details[0].field).to.eql('price'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /products category 999 -> 400 on category_id",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No Such Category Item\",\n  \"category_id\": 999,\n  \"price\": 1,\n  \"stock_quantity\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('details[0].field is category_id', () => pm.expect(pm.response.json().error.details[0].field).to.eql('category_id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products/99999 -> 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/99999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products/abc -> 400",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/abc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products?search=usb",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?search=usb"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('every name contains usb', () => pm.response.json().data.forEach(p => pm.expect(p.name.toLowerCase()).to.include('usb')));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products?category_id=1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?category_id=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('every product is in category 1', () => pm.response.json().data.forEach(p => pm.expect(p.category_id).to.eql(1)));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products?low_stock=true",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?low_stock=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('every product is low on stock', () => pm.response.json().data.forEach(p => { pm.expect(p.is_low_stock).to.eql(true); pm.expect(p.stock_quantity).to.be.at.most(p.reorder_level); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products?sort=-price",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?sort=-price"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('prices go down', () => { const prices = pm.response.json().data.map(p => p.price); for (let i = 1; i < prices.length; i++) pm.expect(prices[i]).to.be.at.most(prices[i - 1]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products all filters together",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?search=e&category_id=1&low_stock=false&sort=-price"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('every product matches every filter', () => pm.response.json().data.forEach(p => { pm.expect(p.name.toLowerCase()).to.include('e'); pm.expect(p.category_id).to.eql(1); pm.expect(p.is_low_stock).to.eql(false); }));",
                  "pm.test('prices go down', () => { const prices = pm.response.json().data.map(p => p.price); for (let i = 1; i < prices.length; i++) pm.expect(prices[i]).to.be.at.most(prices[i - 1]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /products spare product (never sold)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spare {{productName}}\",\n  \"category_id\": 6,\n  \"price\": 1,\n  \"stock_quantity\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('spareId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /products/:id never sold -> 204",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/products/{{spareId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Sales and stock",
      "item": [
        {
          "name": "GET the product: stock before",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('stockBefore', pm.response.json().data.stock_quantity);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /sales qty 2 -> 201",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/sales",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 2,\n  \"payment_method\": \"cash\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('saleId', pm.response.json().data.id);",
                  "pm.test('product_stock_after is 2 lower', () => pm.expect(pm.response.json().data.product_stock_after).to.eql(Number(pm.collectionVariables.get('stockBefore')) - 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET the product: stock is 2 lower",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('stock is ' + (Number(pm.collectionVariables.get('stockBefore')) - 2), () => pm.expect(pm.response.json().data.stock_quantity).to.eql(Number(pm.collectionVariables.get('stockBefore')) - 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /sales qty > stock -> 409 INSUFFICIENT_STOCK",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/sales",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 10000,\n  \"payment_method\": \"cash\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code INSUFFICIENT_STOCK', () => pm.expect(pm.response.json().error.code).to.eql('INSUFFICIENT_STOCK'));",
                  "pm.test('details say how many are available', () => pm.expect(pm.response.json().error.details[0].available).to.eql(Number(pm.collectionVariables.get('stockBefore')) - 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET the product: stock unchanged after the 409",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('stock is ' + (Number(pm.collectionVariables.get('stockBefore')) - 2), () => pm.expect(pm.response.json().data.stock_quantity).to.eql(Number(pm.collectionVariables.get('stockBefore')) - 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /sales payment bitcoin -> 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/sales",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 1,\n  \"payment_method\": \"bitcoin\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error on payment_method', () => pm.expect(pm.response.json().error.details[0].field).to.eql('payment_method'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /sales forged unit_price -> product price used",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/sales",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 1,\n  \"payment_method\": \"card\",\n  \"unit_price\": 0.01\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('unit_price is the product price (20)', () => pm.expect(pm.response.json().data.unit_price).to.eql(20));",
                  "pm.collectionVariables.set('forgedSaleId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /sales/:id qty 2 -> 5 (stock down by 3)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/sales/{{saleId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('stock moved by the difference only', () => pm.expect(pm.response.json().data.product_stock_after).to.eql(Number(pm.collectionVariables.get('stockBefore')) - 1 - 5));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /sales/:id qty 5 -> 1 (stock up by 4)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/sales/{{saleId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('stock moved back by the difference', () => pm.expect(pm.response.json().data.product_stock_after).to.eql(Number(pm.collectionVariables.get('stockBefore')) - 1 - 1));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /sales/:id -> 204",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/sales/{{saleId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET the product: stock restored",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Only the forged-price sale (1 unit) is left."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('stock is ' + (Number(pm.collectionVariables.get('stockBefore')) - 1), () => pm.expect(pm.response.json().data.stock_quantity).to.eql(Number(pm.collectionVariables.get('stockBefore')) - 1));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /sales/:id again -> 404",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/sales/{{saleId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /products/:id with sales -> 409 IN_USE",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code IN_USE', () => pm.expect(pm.response.json().error.code).to.eql('IN_USE'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
